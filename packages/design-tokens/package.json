{
  "name": "@costly/design-tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Costly's design tokens: one typed source, generated as CSS custom properties",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./tokens.css",
    "./tailwind.css": "./tailwind.css"
  },
  "scripts": {
    "generate": "node src/generate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "vitest": "^5.0.2"
  }
}
