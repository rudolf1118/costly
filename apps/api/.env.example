# Copy to .env and adjust. All values are validated at startup (src/platform/config/env.schema.ts).
NODE_ENV=development
# 3000 is a busy default on development machines, for the same reason as the
# 5433/6380 database ports below.
PORT=3100
LOG_LEVEL=info

# Matches docker-compose.yml (`pnpm infra:up`). Ports 5433/6380 avoid clashing
# with a locally installed PostgreSQL or Redis.
DATABASE_URL=postgresql://costly:costly@localhost:5433/costly
REDIS_URL=redis://localhost:6380

# Origin of the web client (apps/web, Vite dev server). The only origin allowed
# to send credentials, and the only Origin accepted by the cookie endpoints.
CORS_ORIGIN=http://localhost:5173

# Signs access tokens (HS256, ADR-0006). This value is public: fine for local
# development, refused when NODE_ENV=production. For any real deployment use
#   openssl rand -base64 48
JWT_ACCESS_SECRET=development-only-secret-replace-for-any-real-deployment

# Reverse proxies in front of the API that may set X-Forwarded-For (rate limits
# use the client IP). 0: none, the header is ignored. Behind one proxy that
# overwrites X-Forwarded-For, use 1.
TRUST_PROXY=0

# Authentication rate limits (ADR-0006). "off" only for tests; refused in production.
AUTH_RATE_LIMIT=on
