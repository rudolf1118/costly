# Copy to .env and adjust. All values are validated at startup (src/platform/config/env.schema.ts).
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Matches docker-compose.yml (`pnpm infra:up`). Ports 5433/6380 avoid clashing
# with a locally installed PostgreSQL or Redis.
DATABASE_URL=postgresql://costly:costly@localhost:5433/costly
REDIS_URL=redis://localhost:6380
