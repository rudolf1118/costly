// Costly's database schema. Domain models arrive with the modules that own
// them (ADR-0003: Prisma for persistence, raw SQL for analytics).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // The API is a CommonJS NestJS app compiled by tsc with node10 resolution,
  // which cannot read the ESM defaults: import.meta or ".ts" import suffixes.
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// identity: the person whose financial data every other table belongs to.
// Constraints Prisma cannot express (the citext extension and CHECKs) are
// written into the migration SQL; see docs/04-database/tables/identity.md.
model User {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// citext: unique regardless of case, stored as the user typed it.
  email        String   @unique @db.Citext
  /// An Argon2id hash in PHC string form, never the password (ADR-0005).
  passwordHash String   @map("password_hash")
  /// ISO 4217 code. v1 supports a single currency (ADR-0002).
  baseCurrency String   @default("AMD") @map("base_currency") @db.Char(3)
  /// IANA time zone name, e.g. Asia/Yerevan. Decides which month a transaction falls in.
  timezone     String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  refreshTokens RefreshToken[]
  accounts      Account[]
  categories    Category[]

  @@map("users")
}

// identity: one row per refresh credential. A family is one login session;
// rotation adds a row to it. The partial unique index (one active token per
// family) and the CHECKs live in the migration SQL; see ADR-0006 and
// docs/04-database/tables/identity.md.
model RefreshToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// Shared by all tokens of one session; new at login, inherited on rotation.
  familyId  String    @default(dbgenerated("uuidv7()")) @map("family_id") @db.Uuid
  /// SHA-256 hex digest of the token. The token itself is never stored.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// The session's absolute expiry, copied to every token of the family.
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set when the token was exchanged for its successor; using it again is reuse.
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ledger: where money lives (docs/02-requirements/ledger-accounts.md).
enum AccountType {
  checking
  cash
  savings
  credit_card

  @@map("account_type")
}

// ledger: a user's financial account. There is deliberately no balance
// column: balances are derived from the opening balance and the ledger. The
// name, currency, amount and date CHECKs and the unique active-name index
// live in the migration SQL; see docs/04-database/tables/ledger.md.
model Account {
  id             String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  name           String
  type           AccountType
  /// ISO 4217; AMD only in v1 (ADR-0002).
  currency       String      @db.Char(3)
  /// Counts towards money available to spend; defaults from the type.
  isLiquid       Boolean     @map("is_liquid")
  /// Minor units (ADR-0002); the balance at the start of openingDate. May be negative.
  openingBalance BigInt      @map("opening_balance")
  openingDate    DateTime    @map("opening_date") @db.Date
  archivedAt     DateTime?   @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, id])
  @@map("accounts")
}

// ledger: what a transaction is classified by
// (docs/02-requirements/ledger-categories.md).
enum CategoryKind {
  income
  expense

  @@map("category_kind")
}

/// Drives fixed-vs-discretionary analytics and which spend recommendations may cut.
enum CategoryNature {
  essential_fixed
  essential_variable
  discretionary

  @@map("category_nature")
}

// ledger: a category, two levels at most. user_id NULL marks a system category,
// shared by every user and seeded by a migration. The name, nature and archive
// CHECKs, the unique active-name index and the trigger that enforces the parent
// rules (depth, kind, owner, immutability) live in the migration SQL; see
// docs/04-database/tables/ledger.md.
model Category {
  id         String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// NULL for a system category.
  userId     String?         @map("user_id") @db.Uuid
  /// NULL for a top-level category; otherwise a top-level category of the same kind.
  parentId   String?         @map("parent_id") @db.Uuid
  name       String
  kind       CategoryKind
  /// Required for expense categories, NULL for income.
  nature     CategoryNature?
  archivedAt DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User?      @relation(fields: [userId], references: [id], onDelete: Restrict)
  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryChildren")

  @@index([userId, id])
  @@index([parentId])
  @@map("categories")
}
